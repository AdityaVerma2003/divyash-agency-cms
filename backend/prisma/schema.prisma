generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ACCOUNT_MANAGER
  CLIENT
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ServiceCategory {
  SEO
  SMM
  GOOGLE_ADS
  META_ADS
  WEB_DESIGN
  GRAPHIC_DESIGN
  CONTENT
  PERFORMANCE_MARKETING
  GOOGLE_MY_BUSINESS
  LOCAL_SEO
  BRAND_PROMOTION
  EVENT_COVERAGE
}

enum BillingCycle {
  MONTHLY
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  RAZORPAY
  BANK_TRANSFER
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ReminderType {
  PRE_DUE
  DUE
  OVERDUE
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum CampaignObjective {
  LEAD_GENERATION
  AWARENESS
  REACH_AND_ENGAGEMENT
  APP_INSTALL
  SOCIAL_MEDIA_VIEWS
  INFLUENCES
  OTHERS
}

enum OnboardingStatus {
  INVITED
  PENDING
  COMPLETE
}

// ── Core identity ───────────────────────────────────────────────────────

model User {
  id                   String           @id @default(uuid())
  name                 String
  email                String           @unique
  passwordHash         String
  role                 Role
  clientId             String?
  client               Client?          @relation(fields: [clientId], references: [id])
  resetToken           String?
  resetTokenExpiresAt  DateTime?
  onboardingStatus     OnboardingStatus @default(INVITED)
  photoUrl             String?
  mobile               String?
  address              String?
  designation          String?
  bankDetails          String?
  socialLinks          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  managedClients Client[]       @relation("AccountManager")
  auditLogs      AuditLog[]
  notifications  Notification[]
  blogPosts      BlogPost[]
}

model Client {
  id               String       @id @default(uuid())
  companyName      String
  contactPerson    String
  email            String       @unique
  phone            String?
  gstin            String?
  address          String?
  status            ClientStatus @default(ACTIVE)
  suspensionReason  String?
  suspensionNotes   String?
  suspendedAt       DateTime?
  suspendedBy       String?
  accountManagerId  String?
  accountManager    User?        @relation("AccountManager", fields: [accountManagerId], references: [id])
  onboardedAt       DateTime     @default(now())
  agreementDetails  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users          User[]
  clientServices ClientService[]
  invoices       Invoice[]
  leads          Lead[]
  reports        Report[]
  clientReports  ClientReport[]
  caseStudies    CaseStudy[]
}

// ── Services & subscriptions ────────────────────────────────────────────

model Service {
  id          String          @id @default(uuid())
  name        String          @unique
  category    ServiceCategory
  description String?
  createdAt   DateTime        @default(now())

  clientServices ClientService[]
}

// The hinge of the schema: a client's subscription to one service.
// Revenue, invoicing, posts and campaigns all attach here.
model ClientService {
  id                     String             @id @default(uuid())
  clientId               String
  client                 Client             @relation(fields: [clientId], references: [id])
  serviceId              String
  service                Service            @relation(fields: [serviceId], references: [id])
  billingCycle           BillingCycle       @default(MONTHLY)
  rate                   Decimal            @db.Decimal(12, 2)
  startDate              DateTime
  endDate                DateTime?
  contractDurationMonths Int?
  status                 SubscriptionStatus @default(ACTIVE)
  pauseReason            String?
  pauseNotes             String?
  statusChangedAt        DateTime?
  statusChangedBy        String?
  createdAt              DateTime           @default(now())

  invoiceItems InvoiceItem[]
  posts        Post[]
  campaigns    Campaign[]
}

// ── Billing ──────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  invoiceNumber String        @unique
  periodStart   DateTime
  periodEnd     DateTime
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  issuedDate    DateTime      @default(now())
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  items     InvoiceItem[]
  payments  Payment[]
  reminders ReminderLog[]
}

model InvoiceItem {
  id              String         @id @default(uuid())
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id])
  clientServiceId String?
  clientService   ClientService? @relation(fields: [clientServiceId], references: [id])
  description     String
  amount          Decimal        @db.Decimal(12, 2)
}

model Payment {
  id               String        @id @default(uuid())
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(RAZORPAY)
  gatewayPaymentId String?
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
}

model ReminderLog {
  id        String       @id @default(uuid())
  invoiceId String
  invoice   Invoice      @relation(fields: [invoiceId], references: [id])
  type      ReminderType
  sentAt    DateTime     @default(now())
}

// ── Performance reporting ───────────────────────────────────────────────

model Post {
  id              String        @id @default(uuid())
  clientServiceId String
  clientService   ClientService @relation(fields: [clientServiceId], references: [id])
  platform        String
  postUrl         String?
  publishedAt     DateTime
  reach           Int           @default(0)
  likes           Int           @default(0)
  comments        Int           @default(0)
  shares          Int           @default(0)
  createdAt       DateTime      @default(now())
}

model Campaign {
  id              String            @id @default(uuid())
  clientServiceId String
  clientService   ClientService     @relation(fields: [clientServiceId], references: [id])
  campaignName    String
  adGroup         String?
  adSet           String?
  objective       CampaignObjective
  spend           Decimal           @default(0) @db.Decimal(12, 2)
  impressions     Int               @default(0)
  clicks          Int               @default(0)
  conversions     Int               @default(0)
  createdAt       DateTime          @default(now())
}

model Lead {
  id                String   @id @default(uuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id])
  serviceId         String?
  month             DateTime
  count             Int      @default(0)
  revenueAttributed Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  month       DateTime
  fileUrl     String
  generatedAt DateTime @default(now())
}

// ── Weekly client reporting ──────────────────────────────────────────────

model ClientReport {
  id                          String   @id @default(uuid())
  clientId                    String
  client                      Client   @relation(fields: [clientId], references: [id])
  weekStartDate               DateTime

  smmTotalPosts               Int?
  smmReach                    Int?
  smmTraffic                  Int?

  seoBacklinks                Int?
  seoTrafficGrowth            Decimal? @db.Decimal(5, 2)
  seoKeywordRanks             String?
  seoBlogsCount               Int?
  seoErrors                   String?

  paidAdsReportUrl            String?

  localSeoReviewsGained       Int?
  localSeoPosts               Int?
  localSeoTotalClicks         Int?
  localSeoCallsReceived       Int?
  localSeoProfileInteractions Int?
  localSeoBookings            Int?

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([clientId, weekStartDate])
}

// ── Case studies ─────────────────────────────────────────────────────────

model CaseStudy {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  title     String?
  pdfUrl    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── System ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BlogPost {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  excerpt         String
  contentMarkdown String
  coverImageUrl   String?
  category        String?
  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  primaryKeyword  String?
  keywords        String?
  faqSchema       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  company   String?
  service   String
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
